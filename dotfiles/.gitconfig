[user]
	email = michaelfromyeg@gmail.com
	name = Michael DeMarco
[color]
  ui = auto
[core]
  pager = delta
  # No editor set on purpose: git falls through to $VISUAL/$EDITOR, which
  # .shellrc resolves per-machine (zed --wait locally, nvim on boxies).
  precomposeunicode = true
  untrackedCache = true
  ignorecase = true
  excludesfile = ~/.gitignore_global
  hooksPath = ~/.config/git/hooks
[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  default = current
  followTags = false
[fetch]
  prune = true
  # Keep the commit-graph current (incremental, cheap) so log/merge-base
  # stay fast in big repos
  writeCommitGraph = true
# Compute changed-path Bloom filters on commit-graph writes -- makes
# `git log -- <path>` ~10x faster in notion-next
[commitGraph]
  changedPaths = true
[diff]
  renames = copies
  algorithm = histogram
[merge]
  log = true
  conflictstyle = zdiff3
[rebase]
  autoStash = true
# Remember conflict resolutions and replay them -- pays for itself with
# av restacks that hit the same conflicts repeatedly
[rerere]
  enabled = true
[delta]
  navigate = true
  line-numbers = true
  hyperlinks = true
  hyperlinks-file-link-format = "zed://file/{path}:{line}"
[interactive]
  diffFilter = delta --color-only
[alias]
  # Push and set upstream
  pushup = push -u origin HEAD
  # Pretty log
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  # Show files ignored by git
  ignored = ls-files -o -i --exclude-standard
  # Undo last commit but keep changes
  undo = reset --soft HEAD^
  # List all aliases
  aliases = config --get-regexp alias
  # Show what you've done since yesterday (needs the ! so $() actually expands)
  standup = "!git log --since yesterday --author \"$(git config user.email)\" --pretty=short"
  # Show last tag
  lasttag = describe --tags --abbrev=0
  # Show modified files in last commit
  files = show --pretty="" --name-only
  cleanup = !git reflog expire --expire=now --all && git gc --prune=now --aggressive && git fsck && git prune && git remote prune origin
  sweep = !git branch --merged main | grep -v main | xargs git branch -d
  # Force push with lease (safer than --force)
  pushf = push --force-with-lease
  # Open all changed files (vs main) in $EDITOR
  open-changed = !git diff --name-only main...HEAD | xargs $EDITOR
# Use gh's credential helper locally; fall back to $GH_TOKEN where gh isn't
# installed (e.g. boxies, which inject GH_TOKEN but have no gh on PATH).
[credential "https://github.com"]
  helper = "!f() { if command -v gh >/dev/null 2>&1; then gh auth git-credential \"$@\"; elif [ \"$1\" = get ] && [ -n \"$GH_TOKEN\" ]; then echo username=x-access-token; echo \"password=$GH_TOKEN\"; fi; }; f"
[advice]
  skippedCherryPicks = false
# Work identity for Notion repos (covers notion-next and its -N worktrees
# locally, and /work/notion-next on boxies). Trailing / matches everything under.
[includeIf "gitdir:~/code/notion-next*/"]
  path = ~/.gitconfig-notion
[includeIf "gitdir:/work/"]
  path = ~/.gitconfig-notion
