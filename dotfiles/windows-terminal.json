      "id": "User.ResizePaneDown",
      "keys": "ctrl+shift+down"
    },
    {
      "id": "User.ResizePaneLeft",
      "keys": "ctrl+shift+left"
    },
    {
      "id": "User.ResizePaneRight",
      "keys": "ctrl+shift+right"
    },
    {
      "id": "Terminal.TogglePaneZoom",
      "keys": "ctrl+shift+enter"
    },
    {
      "id": "Terminal.ToggleFullscreen",
      "keys": "ctrl+enter"
    },
    {
      "id": "User.IncreaseFontSize",
      "keys": "ctrl+="
    },
    {
      "id": "User.DecreaseFontSize",
      "keys": "ctrl+-"
    },
    {
      "id": "Terminal.ResetFontSize",
      "keys": "ctrl+0"
    },
    {
      "id": "User.ShiftEnter",
      "keys": "shift+enter"
    }
