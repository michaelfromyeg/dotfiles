      "keys": "alt+w"
    },
    {
      "id": "User.MoveFocusPrevious",
      "keys": "ctrl+["
    },
    {
      "id": "User.MoveFocusNextInOrder",
      "keys": "ctrl+]"
    },
    {
      "id": "User.MoveFocusUp",
      "keys": "ctrl+alt+up"
    },
    {
      "id": "User.MoveFocusDown",
      "keys": "ctrl+alt+down"
    },
    {
      "id": "User.MoveFocusLeft",
      "keys": "ctrl+alt+left"
