# Personal SSH config — managed by dotfiles, included by ~/.ssh/config

# UseKeychain is macOS-only; don't error on it elsewhere (WSL)
IgnoreUnknown UseKeychain

Host REDACTED-HOST:mdemarco*
  SetEnv TERM=xterm-ghostty

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Reuse connections: repeated ssh/scp to the same host (nbsync, git) skip
  # the handshake. Sockets dir is created by env.sh.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m
