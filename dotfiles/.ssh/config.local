# Personal SSH config — managed by dotfiles, included by ~/.ssh/config

# UseKeychain is macOS-only; don't error on it elsewhere (WSL)
IgnoreUnknown UseKeychain

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Reuse connections: repeated ssh/scp to the same host skip the handshake.
  # Sockets dir is created by env.sh. %C (hash of user/host/port) keeps the
  # path short: long hostnames overflow the 104-byte Unix socket path limit.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
