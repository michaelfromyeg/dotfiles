#!/usr/bin/env bash

# Universal shell configuration for bash and zsh

# History configuration (bash; these vars are no-ops in zsh -- see .zshrc)
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoredups
HISTTIMEFORMAT="%F %T "

# Environment variables
export XDG_CONFIG_HOME="$HOME/.config"
export PATH="$HOME/bin:$PATH"
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

# Ghostty and every terminal we connect from is truecolor, but `notion boxy mosh`
# (forces TERM=xterm-256color) and `notion boxy sshv2` (kubectl exec) both drop
# COLORTERM, so 24-bit apps downgrade to 256 colors. Re-assert it on the remote.
export COLORTERM=truecolor

# Safety net: kubectl exec can leave TERM unset. Only fills in when missing, so a
# forwarded xterm-ghostty / mosh's xterm-256color is left untouched.
: "${TERM:=xterm-256color}"
export TERM

# A UTF-8 locale keeps multibyte glyphs (powerline separators, Nerd Font icons)
# rendering correctly. mosh's launch-time locale is handled in .bash_profile; this
# covers interactive zsh and `notion boxy sshv2`. Only set when unset/non-UTF-8.
case "${LC_ALL:-${LC_CTYPE:-$LANG}}" in
*[Uu][Tt][Ff]-8 | *[Uu][Tt][Ff]8) ;;
*) export LANG=C.UTF-8 ;;
esac

# Zed needs --wait so editor-blocking tools (git, crontab -e, kubectl edit)
# get a real editing session; nvim covers remote boxes where zed isn't installed.
if command -v zed >/dev/null 2>&1; then
  export EDITOR="zed --wait"
elif command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi
export VISUAL="$EDITOR"

# -F: quit if one screen, -R: pass through colors (delta/bat), -X: keep output
# on screen after quit
export LESS="-FRX"
export PAGER=less

# Some common aliases
# Use eza if available, otherwise fall back to ls
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --color=auto'
  alias ll='eza -alF --git'
  alias la='eza -a'
  alias l='eza -F'
  alias tree='eza --tree'
else
  case "$(uname -s)" in
  Darwin*) alias ls='ls -G' ;;
  *) alias ls='ls --color=auto' ;;
  esac
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

# Use bat if available
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
fi
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias c='clear'

# Reset terminal after SSH to clear any terminfo weirdness. Only for
# interactive sessions -- `reset` on a non-tty emits escape junk, and scripted
# ssh calls (see nbsync) shouldn't clear scrollback.
ssh() {
  command ssh "$@"
  local _rc=$?
  [ -t 1 ] && [ -t 0 ] && reset
  return $_rc
}

# (quick) git aliases; more in gitconfig
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -v'
alias gcm='git commit -m'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'
alias gl='git pull'
alias gp='git push'
alias gst='git status'
alias glg='git log --graph --oneline --decorate'
alias grh='git reset HEAD'
alias gsta='git stash'
alias gstp='git stash pop'
alias goc='git open-changed' # defined in .gitconfig

# av (Aviator CLI) shortcuts for stacked PRs
alias avs='av sync'
alias avr='av restack'
alias avsub='av pr --all'
alias avt='av tree'
alias gm='git checkout main' # (gcm is taken by 'git commit -m' above)

# Combines fzf and git add into a handy workflow
ga_fzf() {
  git status -s |
    fzf --multi --preview 'git diff --color=always {2}' --preview-window=right:70% |
    awk '{print $2}' |
    xargs -r git add
}
alias gaf='ga_fzf'

# Creates a new branch with a prefix (thank you @yash)
gnb_f() {
  if [ -z "$1" ]; then
    echo "Usage: gnb <branch-description>"
    echo "Example: gnb fix-login-bug"
    return 1
  fi

  git checkout -b "michaelfromyeg--$1"
  echo "Created and switched to branch: michaelfromyeg--$1"
}
alias gnb='gnb_f'

# Git worktree management functions
# Helper: Copy appropriate config files to new worktree
_gw_copy_configs() {
  local src="$1"
  local dest="$2"

  # Essential files (always copy if they exist)
  local essential_files=(".env" ".envrc" ".notion-cli.json" ".devex.config.yaml" "CLAUDE.local.md")

  for file in "${essential_files[@]}"; do
    if [ -f "$src/$file" ]; then
      cp "$src/$file" "$dest/$file"
      echo "  Copied: $file"
    fi
  done

  # VSCode settings
  if [ -d "$src/.vscode" ]; then
    mkdir -p "$dest/.vscode"
    for file in settings.json launch.json; do
      if [ -f "$src/.vscode/$file" ]; then
        cp "$src/.vscode/$file" "$dest/.vscode/$file"
        echo "  Copied: .vscode/$file"
      fi
    done
  fi

  # Zed settings
  if [ -d "$src/.zed" ]; then
    mkdir -p "$dest/.zed"
    for file in settings.json tasks.json; do
      if [ -f "$src/.zed/$file" ]; then
        cp "$src/.zed/$file" "$dest/.zed/$file"
        echo "  Copied: .zed/$file"
      fi
    done
  fi

  # Cursor MCP config
  if [ -f "$src/.cursor/mcp.json" ]; then
    mkdir -p "$dest/.cursor"
    cp "$src/.cursor/mcp.json" "$dest/.cursor/mcp.json"
    echo "  Copied: .cursor/mcp.json"
  fi

  # Claude local settings
  if [ -f "$src/.claude/settings.local.json" ]; then
    mkdir -p "$dest/.claude"
    cp "$src/.claude/settings.local.json" "$dest/.claude/settings.local.json"
    echo "  Copied: .claude/settings.local.json"
  fi
}

# Create a worktree at ../repo-name-X with config copying
gw_create_f() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository"
    return 1
  fi

  if [ -z "$1" ]; then
    echo "Usage: gwc <branch-name>"
    return 1
  fi

  local branch_name="$1"
  local repo_root
  repo_root=$(git rev-parse --show-toplevel)
  local repo_name
  repo_name=$(basename "$repo_root")
  local parent_dir
  parent_dir=$(dirname "$repo_root")

  # Find next available number
  local counter=1
  while [ -d "$parent_dir/${repo_name}-${counter}" ]; do
    counter=$((counter + 1))
  done

  local worktree_path="$parent_dir/${repo_name}-${counter}"

  echo "Creating worktree at: $worktree_path"
  if git worktree add "$worktree_path" -b "$branch_name" 2>/dev/null ||
    git worktree add "$worktree_path" "$branch_name"; then
    _gw_copy_configs "$repo_root" "$worktree_path"

    # Run notion install-node-modules for notion-next repos
    if [ "$repo_name" = "notion-next" ]; then
      echo "Installing node modules for notion-next..."
      (cd "$worktree_path" && notion install-node-modules)
    fi

    echo "Worktree created: $worktree_path (branch: $branch_name)"
  else
    echo "Error: Failed to create worktree"
    return 1
  fi
}
alias gwc='gw_create_f'

# List worktrees (context-aware: repo or ~/code overview)
gw_list_f() {
  local code_dir="${HOME}/code"

  if git rev-parse --git-dir >/dev/null 2>&1; then
    # In a repo - show worktrees for this repo
    local repo_name
    repo_name=$(basename "$(git rev-parse --show-toplevel)")
    echo "Worktrees for $repo_name:"
    git worktree list --porcelain | awk '
      /^worktree/ { path=$2; has_branch=0 }
      /^branch/ {
        branch=$2
        gsub("refs/heads/", "", branch)
        printf "  %-50s %s\n", path, branch
        has_branch=1
      }
      /^$/ && !has_branch && path {
        printf "  %-50s (detached)\n", path
      }
    '
  elif [ "$(pwd)" = "$code_dir" ] || [[ "$(pwd)" == "$code_dir"* && ! -d ".git" ]]; then
    # In ~/code but not in a repo - show all repos
    echo "Repositories in $code_dir:"
    echo ""
    for dir in "$code_dir"/*/; do
      if [ -d "$dir/.git" ]; then
        local rname bname wtcount
        rname="$(basename "$dir")"
        bname="$(git -C "$dir" branch --show-current 2>/dev/null || echo "(detached)")"
        wtcount="$(git -C "$dir" worktree list 2>/dev/null | wc -l | tr -d ' ')"

        if [ "$wtcount" -gt 1 ]; then
          printf "%-30s %-25s (%d worktrees)\n" "$rname" "$bname" "$wtcount"
          git -C "$dir" worktree list 2>/dev/null | tail -n +2 | while read -r line; do
            printf "  └─ %-28s %s\n" "$(basename "$(echo "$line" | awk '{print $1}')")" "$(echo "$line" | awk '{print $3}' | tr -d '[]')"
          done
        else
          printf "%-30s %s\n" "$rname" "$bname"
        fi
      fi
    done
  else
    echo "Not in a git repository or ~/code directory"
    return 1
  fi
}
alias gwl='gw_list_f'

# Remove a worktree by path or name
gw_remove_f() {
  if [ -z "$1" ]; then
    echo "Usage: gwr <worktree-path-or-name>"
    echo "Example: gwr ../repo-name-1"
    echo "         gwr repo-name-1"
    return 1
  fi

  local target="$1"

  # If it's just a name, resolve relative to parent
  if [[ "$target" != /* && "$target" != ../* && "$target" != ./* ]]; then
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$repo_root" ]; then
      local parent_dir
      parent_dir=$(dirname "$repo_root")
      target="$parent_dir/$target"
    fi
  fi

  if git worktree remove "$target" 2>/dev/null; then
    echo "Removed worktree: $target"
  else
    echo "Error: Failed to remove worktree. Try 'git worktree remove --force $target'"
    return 1
  fi
}
alias gwr='gw_remove_f'

# Sync configs from current worktree to all others
gw_sync_f() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository"
    return 1
  fi

  local current_worktree
  current_worktree=$(git rev-parse --show-toplevel)

  local worktrees=()
  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      local wt_path="${line#worktree }"
      if [ "$wt_path" != "$current_worktree" ]; then
        worktrees+=("$wt_path")
      fi
    fi
  done < <(git worktree list --porcelain)

  if [ ${#worktrees[@]} -eq 0 ]; then
    echo "No other worktrees to sync to"
    return 0
  fi

  echo "Syncing configs from: $current_worktree"
  echo ""
  for wt in "${worktrees[@]}"; do
    echo "→ $(basename "$wt")"
    _gw_copy_configs "$current_worktree" "$wt"
    echo ""
  done
  echo "Sync complete"
}
alias gws='gw_sync_f'

# tmux aliases
alias t='tmux'
alias ta='tmux attach -t'
alias td='tmux detach'
alias tls='tmux list-sessions'
alias tks='tmux kill-session -t'
alias tka='tmux kill-server'
alias tn='tmux new-session -s'
alias tq='tmux kill-session && exit'

# Alert alias for long running commands (Linux/notify-send only)
# Usage: sleep 10; alert
if command -v notify-send >/dev/null 2>&1; then
  alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
fi

# OS-specific configurations
case "$(uname -s)" in
Darwin*)
  # macOS-specific settings (Apple Silicon, then Intel)
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  [ -d "$HOME/Library/Android/sdk" ] && export ANDROID_HOME="$HOME/Library/Android/sdk"
  ;;
Linux*)
  # Linux-specific settings (Linuxbrew, if installed)
  if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
  ;;
esac

# WSL-specific utilities (Linux guard skips the /proc read on macOS)
if [ "$(uname -s)" = "Linux" ] && grep -qi microsoft /proc/version 2>/dev/null; then
  # wslview replacement (wslu was discontinued)
  wslview() {
    if [ -z "$1" ]; then
      echo "Usage: wslview <file or url>"
      return 1
    fi

    if [ -e "$1" ]; then
      # It's a file - convert to Windows path
      cmd.exe /c start "" "$(wslpath -w "$1")" 2>/dev/null
    else
      # Assume it's a URL
      cmd.exe /c start "" "$1" 2>/dev/null
    fi
  }
fi

# Languages
# mise is the single version manager (node, erlang/elixir via ~/.tool-versions,
# and notion-next's .nvmrc via idiomatic_version_file_enable_tools=["node"]).
# It replaced nvm, pyenv, asdf, and rvm here -- together they cost ~0.5s per
# shell and shimmed the same tools mise already provides.

# nvm kept lazily for one-off version work; sourcing it eagerly costs ~400ms.
export NVM_DIR="$HOME/.nvm"
nvm() {
  unset -f nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  nvm "$@"
}

# uv
export PATH="$HOME/.local/bin:$PATH"

# sdkman (java, kotlin, gradle)
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# go (manual install location, Linux only; Homebrew handles macOS)
[ -d /usr/local/go/bin ] && export PATH="/usr/local/go/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"

# oh-my-posh (if installed)
if command -v oh-my-posh >/dev/null 2>&1; then
  # eval "$(oh-my-posh init "$(basename "$SHELL")" --config "$(brew --prefix oh-my-posh)"/themes/gruvbox.omp.json)"
  eval "$(oh-my-posh init "${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}" --config ~/.config/ohmyposh/gruvbox2.omp.json)"
fi

# rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Detect the running shell (not $SHELL, which may differ)
if [ -n "$ZSH_VERSION" ]; then
  _running_shell=zsh
elif [ -n "$BASH_VERSION" ]; then
  _running_shell=bash
else
  _running_shell=$(basename "$SHELL")
fi

# mise (version manager; see the Languages section above). Shims cover
# non-interactive shells; activate takes over in interactive ones.
[ -d "$HOME/.local/share/mise/shims" ] && export PATH="$HOME/.local/share/mise/shims:$PATH"
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate "$_running_shell")"
fi

# zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init "$_running_shell")"
fi

# direnv (per-directory env vars)
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook "$_running_shell")"
fi

unset _running_shell

# Notion-specific configurations (local or boxy)
_notion_next=""
if [ -d "$HOME/code/notion-next" ]; then
  _notion_next="$HOME/code/notion-next"
elif [ -d "/work/notion-next" ]; then
  _notion_next="/work/notion-next"
fi

# shellcheck disable=SC2139  # aliases intentionally bake in the path resolved at shell startup
if [ -n "$_notion_next" ]; then
  export NOTION_ENV=dev

  alias nn="cd $_notion_next"
  alias nn1="cd ${_notion_next}-1"
  alias nn2="cd ${_notion_next}-2"
  alias nn3="cd ${_notion_next}-3"
  alias nr="notion run"
  alias nd="notion desktop run"
  alias ne="notion lint"

  alias nfix="notion lint --branch --fix --ratchet && notion format --branch && notion extract"
  alias ncheck="nfix && notion test --branch && notion typecheck"

  # On boxy, disable the git-hook autofixes (typecheck, lint, relevant tests)
  # that otherwise run on commit/push -- too slow to want blocking a remote box.
  # NOTION_AUTOFIX_TRIGGERS is Notion's sanctioned per-env override; empty turns
  # autofixes off entirely. The cheap safety checks (no pushing main, no replayed
  # commits) still run. Run the disabled checks on demand with the helpers below.
  if [ -n "$NOTION_BOXY_NAME" ]; then
    export NOTION_AUTOFIX_TRIGGERS=""
  fi

  # The push-hook checks, exposed as manual helpers:
  alias ntc="notion typecheck"     # typecheck
  alias ntb="notion test --branch" # relevant tests for the current branch
  # nhook: exactly what the pre-push hook runs -- lint-staged over the branch diff
  nhook() {
    (cd "$(git rev-parse --show-toplevel)" &&
      CI=true NOTION_LINT_STAGED=1 NOTION_LINT_STAGED_HOOK=pre-push \
        ./ntx lint-staged --diff="origin/main...HEAD" --config .lintstagedrc.mjs)
  }

  # Notion Android paths
  if [ -n "${ANDROID_HOME:-}" ]; then
    export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin"
  fi

  # Notion shell completion -- cached, because `notion completion --install`
  # costs ~600ms per shell. Regenerated when the notion CLI script changes.
  if command -v notion >/dev/null 2>&1; then
    _notion_comp="$HOME/.cache/notion-completion-${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}.sh"
    _notion_bin="$(command -v notion)"
    if [ ! -s "$_notion_comp" ] || [ "$_notion_bin" -nt "$_notion_comp" ]; then
      mkdir -p "$HOME/.cache"
      notion completion --install >"$_notion_comp" 2>/dev/null
    fi
    . "$_notion_comp"
    unset _notion_comp _notion_bin
  fi

  # Run all modified test files on current branch vs main
  test-branch() {
    echo "Finding modified test files..."
    local test_files
    test_files=$(git diff --name-only main...HEAD | grep '\.test\.tsx\?$')

    if [ -z "$test_files" ]; then
      echo "No modified test files found"
      return 0
    fi

    echo "Found test files:"
    echo "$test_files"
    echo ""

    echo "$test_files" | while read -r file; do
      if [ -f "$file" ]; then
        echo "========================================"
        echo "Testing: $file"
        echo "========================================"
        notion test "$file"
        echo ""
      fi
    done
  }
fi

# Gemini (service-account key lives outside the repo; keep it chmod 600)
export GOOGLE_CLOUD_PROJECT=assistant-vertex
export GOOGLE_CLOUD_LOCATION=global
if [ -f "$HOME/gemini.json" ]; then
  export GOOGLE_APPLICATION_CREDENTIALS="$HOME/gemini.json"
fi

# PR/CI status (requires gh CLI)
if command -v gh >/dev/null 2>&1; then
  alias prs='gh pr status'
  alias prc='gh pr checks'
  alias prv='gh pr view --web'
fi

# Boxy shortcuts
if command -v notion >/dev/null 2>&1; then
  alias nb='notion boxy'
  nbc() {
    notion boxy claude "$@"
    reset
  }
  nbs() {
    notion boxy ssh "$@"
    reset
  }
  alias nbl='notion boxy ls'
  nbcr() {
    notion boxy create "$@"
    reset
  }
  alias nbd='notion boxy destroy'

  # Copy local secrets/configs that can't be committed to a boxy
  nbsync() {
    local name="${1:?Usage: nbsync <boxy-name>}"
    local host="REDACTED-HOST:${name}"
    echo "Syncing secrets to $name..."
    if [ -f ~/.config/av/config.yaml ]; then
      command ssh "$host" 'mkdir -p ~/.config/av'
      scp ~/.config/av/config.yaml "${host}:~/.config/av/config.yaml"
    fi
    echo "Done."
  }

  # SSH into a boxy in a new named Ghostty tab
  nbopen() {
    local name="${1:?Usage: nbopen <boxy-name>}"
    osascript <<EOF
tell application "Ghostty"
  activate
  set cfg to new surface configuration
  set command of cfg to "bash -c 'printf \"\\\\033]0;boxy: $name\\\\007\"; exec notion boxy ssh $name'"
  set wait after command of cfg to true
  tell front window to new tab with configuration cfg
end tell
EOF
  }

  # Request my standard AWS JIT permissions for 12 hours
  nperms() {
    notion jit create-request --appName "AWS" --resourceName "REDACTED-AWS-ROLE" --duration "12 hours" --justification "Load testing" --notifyMe=false
    notion jit create-request --appName "AWS" --resourceName "REDACTED-AWS-ROLE" --duration "12 hours" --justification "Load testing" --notifyMe=false
    notion jit create-request --appName "AWS" --resourceName "REDACTED-AWS-ROLE" --duration "12 hours" --justification "Load testing" --notifyMe=false
  }

  # SSH into all running boxies, each in a new Ghostty tab
  nbsa() {
    local names
    names=$(notion boxy ls 2>&1 | awk 'NR>3 && /Running/ {print $1}')
    if [ -z "$names" ]; then
      echo "No running boxies found"
      return 1
    fi
    echo "$names" | while IFS= read -r name; do
      echo "Opening tab for $name..."
      nbopen "$name"
    done
  }
fi
